# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values you need.
# NEVER commit the real .env file. Everything secret lives here, not in code.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Run with "flask run --debug"? Set to 0 in production.
FLASK_DEBUG=1

# --- Database ---------------------------------------------------------------
# PostgreSQL is the database this shop should run on: real transactions, row
# locking (two people cannot buy the last tee), real constraints and proper
# backups. Leave DATABASE_URL empty to use the SQLite file instead
# (instance/store.db) - fine for local work, not for a live shop.
#
#   DATABASE_URL=postgresql://user:password@localhost:5432/shopify
DATABASE_URL=
# How many database connections to keep open. 0 = one per request.
# 10 is a good number for a small shop.
DATABASE_POOL_SIZE=0

# --- Storefront ------------------------------------------------------------
STORE_NAME=Playbook Tees
STORE_TAGLINE=Graphic tees for people who never sit out
STORE_EMAIL=hello@playbooktees.in
STORE_PHONE=+91 90000 00000
STORE_ADDRESS=Your studio address, City, State - 400001
STORE_CURRENCY=INR

# Default selling price for a T-shirt, in RUPEES (no symbol). Change it and
# re-seed, or edit each product in the admin area.
DEFAULT_TEE_PRICE=599

# Shipping in RUPEES. Orders at or above FREE_SHIPPING_THRESHOLD ship free.
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999

# --- Admin login -----------------------------------------------------------
ADMIN_USERNAME=admin
# Generate with:  python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# --- Payments ---------------------------------------------------------------
# Real-time UPI. The customer scans the QR with any UPI app (GPay, PhonePe,
# Paytm, BHIM) and pays the exact order total. The checkout page draws its
# own QR code for every order with the amount already filled in, so nobody
# types the wrong number. The order is only marked paid once you confirm the
# money in Admin -> Orders, so nothing is faked.
UPI_ID=
UPI_PAYEE_NAME=
# Fallback QR image inside the static folder, used only when the QR library
# (segno) is not installed.
UPI_QR_IMAGE=img/payment/upi_qr.jpg

# Razorpay (cards, netbanking, auto-verified payments) - OPTIONAL.
# Leave these EMPTY to run on the UPI QR above. With no method at all the site
# runs in clearly-labelled test mode and no money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create a webhook for the "payment.captured" event pointing at
# https://your-domain/checkout/api/webhooks/razorpay and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# Cash on delivery. Set to 1 to offer "Cash on delivery" at checkout; the
# order is confirmed straight away and you mark it paid in Admin -> Orders
# once the courier collects the cash.
COD_ENABLED=0
# Extra handling fee for COD orders, in RUPEES. 0 = no fee.
COD_FEE=0
# Require an SMS OTP before accepting a COD order. Works without a gateway:
# the code is shown on screen when no SMS provider is configured.
OTP_REQUIRED=0
OTP_TTL_SECONDS=600

# --- Delivery ---------------------------------------------------------------
# Comma-separated PIN prefixes you deliver to (e.g. 400,560,110). Empty = all.
SERVICEABLE_PINCODES=
DELIVERY_MIN_DAYS=4
DELIVERY_MAX_DAYS=7

# --- GST invoice ------------------------------------------------------------
STORE_LEGAL_NAME=Playbook Tees
STORE_GSTIN=
GST_PERCENT=5
INVOICE_PREFIX=INV

# --- Notifications (OPTIONAL) ----------------------------------------------
# Order emails need SMTP. Leave empty and notifications are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
ORDER_ALERT_EMAIL=
# SMS gateway webhook (receives JSON {"to": "...", "message": "..."}).
SMS_WEBHOOK_URL=
# WhatsApp click-to-chat number shown to customers, with country code.
WHATSAPP_NUMBER=

# --- Reviews & carts --------------------------------------------------------
# 1 = new reviews appear immediately. 0 = hold them for moderation.
REVIEWS_AUTO_APPROVE=0
# Carts older than this many hours with no order show as abandoned.
ABANDONED_CART_HOURS=2

# --- Image storage (Cloudinary) - optional ---------------------------------
# Render's free plan has no persistent disk, so uploaded photos disappear on
# restart. Create a free Cloudinary account and paste its API environment
# variable (cloudinary://key:secret@cloud-name). Leave empty for local disk.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=shpify

# --- Print-on-demand supplier (Qikink) - OPTIONAL --------------------------
# Leave EMPTY and the site will keep reporting "supplier not connected".
# Sandbox and Live are separate environments with separate product catalogues.
QIKINK_SANDBOX_MODE=1
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_SANDBOX_SECRET=
QIKINK_API_BASE=https://sandbox.qikink.com
QIKINK_WEBHOOK_SECRET=
